alias n0 d0
alias n1 d1
alias n2 d2
alias n3 d3
alias n4 d4
alias n5 d5
alias house r0
alias cond r1
alias cur r2
alias next r3
define MEMH HASH("StructureLogicMemory")
define SLOT0 HASH("slot0")
define SLOT1 HASH("slot1")
define SELECTW HASH("selector_worker")
define FINW HASH("finstd_worker")
init:
l house db PrefabHash
s db Setting 0
main:
yield
lbn cond MEMH SLOT0 PrefabHash Maximum
bne cond MEMH no_s0
lbn cond MEMH SLOT1 PrefabHash Maximum
bne cond MEMH no_s1
lbn cond house SELECTW PrefabHash Maximum
bne cond house no_sel
lbn cond house FINW PrefabHash Maximum
bne cond house no_fin
lbn next house SELECTW Setting Maximum
bltz next sync
slt cond next 600
bnez cond sync
slt cond 699 next
bnez cond sync
s db Setting 260
j main
sync:
lbn cur MEMH SLOT0 Setting Maximum
beq cur next stat
sbn MEMH SLOT0 Setting next
stat:
beqz next idle
s db Setting next
j main
idle:
s db Setting 200
j main
no_s0:
s db Setting 248
j main
no_s1:
s db Setting 249
j main
no_sel:
s db Setting 250
j main
no_fin:
s db Setting 251
j main
