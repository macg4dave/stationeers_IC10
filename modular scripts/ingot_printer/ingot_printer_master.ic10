alias stk d0
alias n1 d1
alias n2 d2
alias n3 d3
alias n4 d4
alias n5 d5
alias house r0
alias cur r1
alias prev r2
alias cond r3
alias val r4
define MEMH HASH("StructureLogicMemory")
define SLOT0 HASH("slot0")
define SELECTW HASH("selector_worker")
init:
l house db PrefabHash
move cur 0
move prev 0
s db Setting 0
main:
yield
bdns d0 no_stk
lbn cond MEMH SLOT0 PrefabHash Maximum
bne cond MEMH no_slot
lbn cond house SELECTW PrefabHash Maximum
bne cond house no_select
l cond stk On
bnez cond chk_mode
s stk On 1
chk_mode:
l cond stk Mode
beqz cond chk_set
s stk Mode 0
chk_set:
l cond stk Setting
beq cond 1000 chk_batch
s stk Setting 1000
chk_batch:
l val stk ExportCount
beqz cur choose
bgt val prev choose
s db Setting cur
j main
choose:
move prev val
lbn cur house SELECTW Setting Maximum
bltz cur active
bgt cur 699 active
sbn MEMH SLOT0 Setting 0
none:
s db Setting 200
j main
active:
sbn MEMH SLOT0 Setting cur
s db Setting cur
j main
no_stk:
s db Setting 242
j main
no_slot:
s db Setting 248
j main
no_select:
s db Setting 249
j main
