# potato_harvie_test_worker_sensor
# d0=hydro d1=slot0 d2=slot1 d3=slot2 d4=day d5=n5
alias hydro d0
alias slot0 d1
alias slot1 d2
alias slot2 d3
alias day d4
alias n5 d5
alias flags r0
alias tmp r1
alias cond r2
alias growth r3
alias eff r4

define DAYLIGHT_VERT_MAX 90

init:
s db Setting 100
main:
yield
bdns hydro main
bdns slot0 main
bdns slot1 main
bdns slot2 main
bdns day main
move flags 0
ls cond hydro 0 Occupied
beqz cond chk_mat
or flags flags 1
chk_mat:
ls cond hydro 0 Mature
beqz cond chk_seed
or flags flags 2
chk_seed:
ls tmp hydro 0 Seeding
sgt cond tmp 0
beqz cond chk_hp
or flags flags 4
chk_hp:
ls tmp hydro 0 Health
sgt cond tmp 0.5
beqz cond chk_day
or flags flags 8
chk_day:
l tmp day Vertical
abs tmp tmp
sgt cond tmp DAYLIGHT_VERT_MAX
bnez cond save
or flags flags 16
save:
ls growth hydro 0 Growth
ls eff hydro 0 Efficiency
s slot0 Setting flags
s slot1 Setting growth
s slot2 Setting eff
s db Setting 110
j main
