# potato_harvie_test_setup_guard
# d0=sensw d1=actw d2=ctok d3=ctype d4=lev d5=n5
alias sensw d0
alias actw d1
alias ctok d2
alias ctype d3
alias lev d4
alias n5 d5
alias cond r0
alias inited r1

define EXPECTED_LEV 1220484876

init:
move inited 0
s db Setting 0
main:
yield
bdns sensw main
bdns actw main
bdns ctok main
bdns ctype main
bdns lev main
l cond lev PrefabHash
bne cond EXPECTED_LEV bad_lev
l cond sensw On
bnez cond chk_act
s sensw On 1
chk_act:
l cond actw On
bnez cond initm
s actw On 1
initm:
bnez inited ok
s ctok Setting 0
s ctype Setting 0
move inited 1
s db Setting 10
j main
ok:
s db Setting 1
j main
bad_lev:
s db Setting 94
j main
