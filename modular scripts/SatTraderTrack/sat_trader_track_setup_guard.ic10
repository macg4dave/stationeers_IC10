# sat_trader_track_setup_guard
# d0=dishw d1=alertw d2=ctok d3=ctype d4=dial d5=typeled
alias dishw d0
alias alertw d1
alias ctok d2
alias ctype d3
alias dial d4
alias led d5
alias cond r0
alias inited r1
define HASH_SKIP -1
define EXPECTED_DIAL 554524804
define MED -449434216
define LRG HASH("Large_Satellite_Dish")
define MEDNAME HASH("dish_m")
define LRGNAME HASH("dish_l")
init:
move inited 0
s db Setting 0
main:
yield
bdns dishw main
bdns alertw main
bdns ctok main
bdns ctype main
bdns dial main
bdns led main
l cond dial PrefabHash
bne cond EXPECTED_DIAL bad_dial
lbn cond MED MEDNAME PrefabHash Maximum
bne cond MED bad_dish
lbn cond LRG LRGNAME PrefabHash Maximum
bne cond LRG bad_dish
l cond dishw On
bnez cond aw
s dishw On 1
aw:
l cond alertw On
bnez cond initm
s alertw On 1
initm:
bnez inited ok
s ctok Setting 0
s ctype Setting 0
move inited 1
s db Setting 10
j main
ok:
s db Setting 1
j main
bad_dish:
s db Setting 97
j main
bad_dial:
s db Setting 94
j main
