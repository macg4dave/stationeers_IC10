# lights_on_when_dark - every light on the network on from ON_AT to OFF_AT (sun time)
# d0=Daylight Sensor: flat facing up, or on a wall with WALL 1 (a guess, see README).
# Lights are found by type. ON_AT/OFF_AT are HHMM (1800 = 18:00), in the sun time of
# display_clock_from_sun (06:00 sunrise): keep RISE_DEG and SHIFT_MIN equal in both.
# db Setting: 0=lights off 1=lights on 9=Daylight Sensor missing
alias sensor d0
alias deg r0
alias mins r1
alias x r2
alias y r3
alias z r4
alias want r5
alias t r6
alias cur r7
alias on r8
alias off r9
define ON_AT 1800
define OFF_AT 630
define RISE_DEG 0
define SHIFT_MIN 0
define WALL 0
define WALL_FACE 180
define WALL_TURN 0
define SENSOR_HASH 1076425094
define L_WALL -1860064656
define L_WALLBAT -1306415132
define L_LONG 797794350
define L_LONGANG 1847265835
define L_LONGWIDE 555215790
define L_ROUND 1514476632
define L_ROUNDANG 1592905386
define L_ROUNDSM 1436121888
div on ON_AT 100
floor on on
mul on on -40
add on on ON_AT
div off OFF_AT 100
floor off off
mul off off -40
add off off OFF_AT
wait:
s db Setting 9
yield
bdns sensor wait
l t sensor PrefabHash
bne t SENSOR_HASH wait
main:
yield
bdns sensor wait
l t sensor PrefabHash
bne t SENSOR_HASH wait
l t sensor On
bnez t powered
s sensor On 1
powered:
bnez WALL wall
l deg sensor Horizontal
sub deg deg RISE_DEG
mul deg deg deg2rad
cos x deg
l z sensor Vertical
mul cur z deg2rad
sin cur cur
mul x x cur
sub z 90 z
j path
wall:
l deg sensor Horizontal
add deg deg WALL_TURN
mul deg deg deg2rad
cos z deg
sin y deg
l cur sensor Vertical
mul cur cur deg2rad
sin x cur
mul y y x
cos x cur
mul t WALL_FACE deg2rad
cos cur t
mul x x cur
sin cur t
mul y y cur
sub x x y
path:
mul y x x
sub y 1 y
sqrt y y
bgez z above
sub y 0 y
above:
atan2 deg y x
mul mins deg 229.18311805232929
add mins mins 3240
add mins mins SHIFT_MIN
mod mins mins 1440
floor mins mins
sge t mins on
slt cur mins off
and want t cur
or t t cur
sgt cur on off
select want cur t want
s db Setting want
move t L_WALL
jal set
move t L_WALLBAT
jal set
move t L_LONG
jal set
move t L_LONGANG
jal set
move t L_LONGWIDE
jal set
move t L_ROUND
jal set
move t L_ROUNDANG
jal set
move t L_ROUNDSM
jal set
j main
set:
lb cur t On Average
beq cur want set_ok
sb t On want
set_ok:
j ra
