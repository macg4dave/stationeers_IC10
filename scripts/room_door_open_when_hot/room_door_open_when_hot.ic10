# room_door_open_when_hot - Glass Door opens when the room is hot
# d0=Gas Sensor (room)  d1=Glass Door
# Door OPEN above 30C, CLOSED below 28C, holds in between.
# Keeps the door powered (On=1) and unlocked so it can move.
# db Setting: 0=closed 1=open 9=device missing/no reading

alias sensor d0
alias door d1
alias tc r0
alias want r1
alias cur r2

define OPEN_ABOVE_C 30
define CLOSE_BELOW_C 28

wait:
s db Setting 9
yield
bdns sensor wait
bdns door wait
l want door Open

main:
yield
bdns sensor wait
bdns door wait
l tc sensor Temperature
blez tc wait
sub tc tc 273.15
sgt cur tc OPEN_ABOVE_C
select want cur 1 want
slt cur tc CLOSE_BELOW_C
select want cur 0 want
l cur door Lock
beqz cur unlocked
s door Lock 0
unlocked:
l cur door On
bnez cur powered
s door On 1
powered:
l cur door Open
beq cur want report
s door Open want
report:
s db Setting want
j main
