# phase_change_cooling_valve - open "cold" valves when a phase-change device is hot
# d0=phase_change_device. Pipe Digital Valves named exactly cold on the network.
# OPEN above 30C, CLOSE below 28C, holds in between (starts closed).
# Re-sends the state every ~10 s so newly built valves join in.
# db Setting: 0=closed 1=open 9=device missing/no reading

alias dev d0
alias tc r0
alias want r1
alias sent r2
alias ticks r3
alias cur r4

define OPEN_ABOVE_C 30
define CLOSE_BELOW_C 28
define VALVE_HASH -1280984102
define VALVE_NAME HASH("cold")
define RESEND_TICKS 20

move sent -1

wait:
s db Setting 9
yield
bdns dev wait

main:
yield
bdns dev wait
l tc dev Temperature
blez tc wait
sub tc tc 273.15
sgt cur tc OPEN_ABOVE_C
select want cur 1 want
slt cur tc CLOSE_BELOW_C
select want cur 0 want
sub ticks ticks 1
bne want sent send
bgtz ticks report
send:
sbn VALVE_HASH VALVE_NAME Lock 0
sbn VALVE_HASH VALVE_NAME On want
move sent want
move ticks RESEND_TICKS
report:
s db Setting want
j main
