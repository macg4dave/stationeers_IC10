# pipe_vents_fill_to_10mpa - Active Vents fill a pipe to 10 MPa
# d0=Pipe Analyzer. Active Vents named exactly PIPE_VENT on the network.
# Below 9.9 MPa: vents pull room gas into the pipe (Inward, limit 10 MPa).
# At 10 MPa: vents OFF until the pipe drops below 9.9 MPa again.
# Analyzer Error => vents OFF. Re-applies the filling state every ~6 s.
# db Setting: 0=idle 1=filling 9=analyzer missing/fault

alias pipe d0
alias kpa r0
alias state r1
alias ticks r2
alias cur r3

define TARGET_KPA 10000
define START_BELOW_KPA 9900
define VENT_HASH -1129453144
define VENT_NAME HASH("PIPE_VENT")
define MODE_FILL 1
define REAPPLY_TICKS 12

wait:
s db Setting 9
yield
bdns pipe wait
j stop

main:
yield
bdns pipe wait
l cur pipe Error
bnez cur stop
l kpa pipe Pressure
bnez state filling
blt kpa START_BELOW_KPA fill
s db Setting 0
sleep 1
j main

filling:
bge kpa TARGET_KPA stop
s db Setting 1
sub ticks ticks 1
bgtz ticks main
fill:
move state 1
move ticks REAPPLY_TICKS
s db Setting 1
sbn VENT_HASH VENT_NAME Lock 0
sbn VENT_HASH VENT_NAME Mode MODE_FILL
yield
sbn VENT_HASH VENT_NAME Setting TARGET_KPA
sbn VENT_HASH VENT_NAME Open 1
sbn VENT_HASH VENT_NAME On 1
sbn VENT_HASH VENT_NAME Lock 1
j main

stop:
move state 0
s db Setting 0
sbn VENT_HASH VENT_NAME Lock 0
sbn VENT_HASH VENT_NAME On 0
sbn VENT_HASH VENT_NAME Open 0
sleep 1
j main
