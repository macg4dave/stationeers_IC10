# pipe_valve_open_when_clean - valve open only with no methane and no steam
# d0=Pipe Analyzer  d1=Pipe Digital Valve
# Valve ON while RatioMethane and RatioSteam are both ~0 and pressure > 1 kPa.
# Anything else, or analyzer Error => valve OFF.
# db Setting: 0=closed 1=open 9=fault/device missing

alias pipe d0
alias valve d1
alias val r0
alias want r1
alias cur r2

define EPS 0.000001
define MIN_KPA 1

wait:
s db Setting 9
yield
bdns pipe wait
bdns valve wait

main:
yield
bdns pipe wait
bdns valve wait
move want 0
l cur pipe Error
bnez cur apply
l val pipe Pressure
ble val MIN_KPA apply
l val pipe RatioMethane
bgt val EPS apply
l val pipe RatioSteam
sle want val EPS
apply:
select cur cur 9 want
s db Setting cur
l cur valve On
beq cur want main
s valve On want
j main
