# suit_helmet_auto_open - helmet opens itself in safe air, closes when it is not
# Put this chip in the Hardsuit: db=Hardsuit  d0=Hardsuit Helmet
# Safe = 4..45 C outside AND 80..150 kPa outside.
# Safe: open the helmet once. If you close it yourself, it stays closed until
#       the air goes unsafe and safe again (or you open it again).
# Unsafe: close the helmet immediately.

alias suit db
alias helmet d0
alias tc r0
alias kpa r1
alias safe r2
alias hold r3
alias cur r4
alias prev r5
alias tmp r6

define MIN_C 4
define MAX_C 45
define MIN_KPA 80
define MAX_KPA 150

main:
sleep 1
bdns helmet main
l tc suit TemperatureExternal
sub tc tc 273.15
l kpa suit PressureExternal
l cur helmet Open
sge safe tc MIN_C
sle tmp tc MAX_C
and safe safe tmp
sge tmp kpa MIN_KPA
and safe safe tmp
sle tmp kpa MAX_KPA
and safe safe tmp
beqz safe unsafe
bnez hold holding
# we opened it last time but it is closed now => player closed it: hold
seqz tmp cur
and hold tmp prev
seqz tmp hold
j apply
holding:
# held closed until the player opens it again
seqz hold cur
move tmp cur
j apply
unsafe:
move hold 0
move tmp 0
apply:
move prev tmp
beq cur tmp main
l cur helmet Lock
beqz cur unlocked
s helmet Lock 0
unlocked:
s helmet Open tmp
j main
