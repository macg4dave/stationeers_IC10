# display_clock_from_sun - 24 h clock (HH and MM) from the sun's position
# d0=LED Display (hours)  d1=LED Display (minutes)  d3=Daylight Sensor
# Time = Daylight Sensor Horizontal angle (0..360 deg) mapped to 00:00..23:59.
# Tuning: SENSOR_DIRECTION = sensor facing (0..3, adds 90 deg each),
#   OFFSET_DEG shifts the angle, INVERT 1 runs the angle backwards,
#   SHIFT_MIN moves the clock by whole minutes.
# Displays are kept On in Mode 10 (two-character text).

alias hdisp d0
alias mdisp d1
alias sun d3
alias deg r0
alias mins r1
alias hh r2
alias mm r3
alias val r4
alias cur r5
alias tens r6

define SENSOR_DIRECTION 0
define OFFSET_DEG 0
define INVERT 0
define SHIFT_MIN 0
define MODE_TEXT 10

main:
yield
bdns hdisp main
bdns mdisp main
bdns sun main
l deg sun Horizontal
mul cur SENSOR_DIRECTION 90
add deg deg cur
add deg deg OFFSET_DEG
add deg deg 360
mod deg deg 360
beqz INVERT no_inv
sub deg 360 deg
no_inv:
floor deg deg
mul mins deg 1440
div mins mins 360
floor mins mins
add mins mins SHIFT_MIN
add mins mins 1440
mod mins mins 1440
div hh mins 60
floor hh hh
mul mm hh 60
sub mm mins mm
move val hh
jal pack
l cur hdisp Setting
beq cur val h_ok
s hdisp Setting val
h_ok:
move val mm
jal pack
l cur mdisp Setting
beq cur val m_ok
s mdisp Setting val
m_ok:
l cur hdisp Mode
beq cur MODE_TEXT hm_ok
s hdisp Mode MODE_TEXT
hm_ok:
l cur mdisp Mode
beq cur MODE_TEXT mm_ok
s mdisp Mode MODE_TEXT
mm_ok:
l cur hdisp On
bnez cur ho_ok
s hdisp On 1
ho_ok:
l cur mdisp On
bnez cur main
s mdisp On 1
j main

# val (0..99) -> two ASCII digits packed as one number ("07" etc.)
pack:
div tens val 10
floor tens tens
mul cur tens 10
sub val val cur
add val val 48
add tens tens 48
mul tens tens 256
add val val tens
j ra
