# landing_pad_methane_unload - unload pure methane from a landing pad
# d0=Pipe Analyzer (destination pipe)  d1=Landingpad Gas Output
# d2=Pipe Digital Valve  d3=override (optional: any device with Setting, e.g. dial)
# Pad output + valve ON while the pad gas is >= 99.9% methane,
# or while d3 Setting >= 1 (manual override).
# Pressure cutoff: everything OFF above 20 MPa, re-armed below 19 MPa.
# db Setting: 10=unloading 20=not pure methane 30=pressure cutoff
#             40=override on 9=device missing

alias pipe d0
alias pad d1
alias valve d2
alias ovr d3
alias val r0
alias want r1
alias cur r2
alias st r3
alias trip r4

define METHANE_MIN 0.999
define CUTOFF_KPA 20000
define REARM_KPA 19000
define OVERRIDE_ON 1

wait:
s db Setting 9
yield
bdns pipe wait
bdns pad wait
bdns valve wait

main:
yield
bdns pipe wait
bdns pad wait
bdns valve wait
l val pipe Pressure
sgt cur val CUTOFF_KPA
select trip cur 1 trip
slt cur val REARM_KPA
select trip cur 0 trip
move st 30
move want 0
bnez trip apply
move st 40
move want 1
bdns ovr auto
l val ovr Setting
bge val OVERRIDE_ON apply
auto:
l val pad RatioMethane
sge want val METHANE_MIN
select st want 10 20

apply:
s db Setting st
l cur pad On
beq cur want pad_ok
s pad On want
pad_ok:
l cur valve Lock
beqz cur unlocked
s valve Lock 0
unlocked:
l cur valve On
beq cur want main
s valve On want
j main
