# pipe_methane_purge_vent - vent a pipe while it has methane and too little O2
# d0=Pipe Analyzer  d1=Active Vent (on the same pipe)
# Vent ON+Open while methane is present AND RatioOxygen < 33%.
# Otherwise, or on analyzer Error, vent OFF. Vent is kept in Mode 0 (Outward).
# db Setting: 0=vent off 1=purging 9=fault/device missing

alias pipe d0
alias vent d1
alias ch4 r0
alias o2 r1
alias want r2
alias cur r3
alias cur2 r4

define EPS 0.000001
define O2_TARGET 0.33
define MODE_OUTWARD 0

wait:
s db Setting 9
yield
bdns pipe wait
bdns vent wait

main:
yield
bdns pipe wait
bdns vent wait
move want 0
l cur pipe Error
bnez cur apply
l ch4 pipe RatioMethane
ble ch4 EPS apply
l o2 pipe RatioOxygen
slt want o2 O2_TARGET
apply:
select cur cur 9 want
s db Setting cur
l cur vent Mode
beq cur MODE_OUTWARD mode_ok
s vent Mode MODE_OUTWARD
mode_ok:
l cur vent On
l cur2 vent Open
bne cur want write
beq cur2 want main
write:
s vent Open want
s vent On want
j main
