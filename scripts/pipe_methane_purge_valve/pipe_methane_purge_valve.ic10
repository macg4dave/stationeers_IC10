# pipe_methane_purge_valve - purge methane through a valve until O2 catches up
# d0=Pipe Analyzer  d1=Pipe Digital Valve
# Valve ON while methane is present AND RatioOxygen < 33% of RatioMethane.
# Otherwise, or on analyzer Error, valve OFF.
# db Setting: 0=closed 1=purging 9=fault/device missing

alias pipe d0
alias valve d1
alias ch4 r0
alias o2 r1
alias want r2
alias cur r3

define EPS 0.000001
define O2_PER_CH4 0.33

wait:
s db Setting 9
yield
bdns pipe wait
bdns valve wait

main:
yield
bdns pipe wait
bdns valve wait
move want 0
l cur pipe Error
bnez cur apply
l ch4 pipe RatioMethane
ble ch4 EPS apply
l o2 pipe RatioOxygen
mul ch4 ch4 O2_PER_CH4
slt want o2 ch4
apply:
select cur cur 9 want
s db Setting cur
l cur valve On
beq cur want main
s valve On want
j main
