# pipe_valves_open_when_cold - open every valve named "cold" when the pipe is cold
# d0=Pipe Analyzer. Pipe Digital Valves named exactly cold on the data network.
# OPEN below 10C, CLOSE above 30C, holds in between (starts closed).
# Re-sends the state every ~10 s so newly built valves join in.
# db Setting: 0=closed 1=open 9=analyzer missing/fault

alias pipe d0
alias tc r0
alias want r1
alias sent r2
alias ticks r3
alias cur r4

define OPEN_BELOW_C 10
define CLOSE_ABOVE_C 30
define VALVE_HASH -1280984102
define VALVE_NAME HASH("cold")
define RESEND_TICKS 20

move sent -1

wait:
s db Setting 9
yield
bdns pipe wait

main:
yield
bdns pipe wait
l cur pipe Error
bnez cur wait
l tc pipe Temperature
blez tc wait
sub tc tc 273.15
slt cur tc OPEN_BELOW_C
select want cur 1 want
sgt cur tc CLOSE_ABOVE_C
select want cur 0 want
sub ticks ticks 1
bne want sent send
bgtz ticks report
send:
sbn VALVE_HASH VALVE_NAME Lock 0
sbn VALVE_HASH VALVE_NAME On want
move sent want
move ticks RESEND_TICKS
report:
s db Setting want
j main
