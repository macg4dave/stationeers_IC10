# air_conditioner_hold_25c - keeps an Air Conditioner running at 25C
# Put this chip INSIDE the Air Conditioner: db = the Air Conditioner.
# Writes Setting (Kelvin), Mode=1 (Active) and On=1, only when they differ.

alias ac db
alias cur r0
alias target r1

define TARGET_C 25
define MODE_ACTIVE 1

add target TARGET_C 273.15

main:
yield
bdns db main
l cur ac Setting
beq cur target mode_chk
s ac Setting target
mode_chk:
l cur ac Mode
beq cur MODE_ACTIVE on_chk
s ac Mode MODE_ACTIVE
on_chk:
l cur ac On
bnez cur main
s ac On 1
j main
