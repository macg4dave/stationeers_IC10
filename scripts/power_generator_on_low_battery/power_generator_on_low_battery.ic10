# power_generator_on_low_battery - generator charges the large batteries
# d0=Gas Fuel Generator. Every Station Battery (Large) on the network is read.
# Generator ON when the average charge drops below 30%,
# OFF again once it is above 80%. Holds in between.
# No large batteries found => generator OFF.
# db Setting: 0=gen off 1=gen on 2=no batteries found 9=generator missing

alias gen d0
alias ratio r0
alias want r1
alias cur r2

define BATTERY_HASH HASH("StructureBatteryLarge")
define ON_BELOW 0.30
define OFF_ABOVE 0.80

wait:
s db Setting 9
yield
bdns gen wait
l want gen On

main:
yield
bdns gen wait
lb cur BATTERY_HASH PrefabHash Maximum
bne cur BATTERY_HASH none
lb ratio BATTERY_HASH Ratio Average
slt cur ratio ON_BELOW
select want cur 1 want
sgt cur ratio OFF_ABOVE
select want cur 0 want
s db Setting want
j apply
none:
move want 0
s db Setting 2
apply:
l cur gen On
beq cur want main
s gen On want
j main
