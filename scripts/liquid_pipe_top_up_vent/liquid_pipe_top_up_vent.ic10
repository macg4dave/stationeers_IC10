# liquid_pipe_top_up_vent - Active Vent runs while a liquid pipe is under-filled
# d0=Liquid Pipe Analyzer  d1=Active Vent
# Fill % = VolumeOfLiquid / Volume. Vent ON+Open below 50%, OFF above 55%.
# Vent is kept in VENT_MODE. VENT_LOCK 1 locks the vent after each change.
# db Setting: 0=vent off 1=vent on 9=device missing/no pipe volume

alias pipe d0
alias vent d1
alias pct r0
alias vol r1
alias want r2
alias cur r3
alias cur2 r4

define ON_BELOW_PCT 50
define OFF_ABOVE_PCT 55
# 0 = Outward, 1 = Inward
define VENT_MODE 0
define VENT_LOCK 0

wait:
s db Setting 9
yield
bdns pipe wait
bdns vent wait
l want vent On

main:
yield
bdns pipe wait
bdns vent wait
l vol pipe Volume
blez vol wait
l pct pipe VolumeOfLiquid
div pct pct vol
mul pct pct 100
slt cur pct ON_BELOW_PCT
select want cur 1 want
sgt cur pct OFF_ABOVE_PCT
select want cur 0 want
s db Setting want
l cur vent Mode
l cur2 vent On
bne cur VENT_MODE write
bne cur2 want write
l cur vent Open
beq cur want main
write:
s vent Lock 0
l cur vent Mode
beq cur VENT_MODE mode_ok
s vent Mode VENT_MODE
mode_ok:
s vent Open want
s vent On want
beqz VENT_LOCK main
s vent Lock 1
j main
