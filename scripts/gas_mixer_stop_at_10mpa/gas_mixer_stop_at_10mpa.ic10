# gas_mixer_stop_at_10mpa - Gas Mixer stops when its output pipe is full
# d0=Pipe Analyzer (mixer output pipe)  d1=Gas Mixer
# Mixer OFF above 10 MPa, back ON below 9.5 MPa, holds in between.
# Analyzer switched off => script turns it on (mixer OFF meanwhile).
# Analyzer Error => mixer OFF.
# db Setting: 0=mixer off 1=mixer on 3=analyzer error 4=analyzer was off 9=missing

alias pipe d0
alias mix d1
alias kpa r0
alias want r1
alias cur r2
alias st r3

define STOP_ABOVE_KPA 10000
define RESUME_BELOW_KPA 9500

wait:
s db Setting 9
yield
bdns pipe wait
bdns mix wait
l want mix On

main:
yield
bdns pipe wait
bdns mix wait
move st 4
l cur pipe On
beqz cur analyzer_off
move st 3
l cur pipe Error
bnez cur force_off
l kpa pipe Pressure
sgt cur kpa STOP_ABOVE_KPA
select want cur 0 want
slt cur kpa RESUME_BELOW_KPA
select want cur 1 want
move st want
j apply
analyzer_off:
s pipe On 1
force_off:
move want 0
apply:
s db Setting st
l cur mix On
beq cur want main
s mix On want
j main
