# furnace_heat_pipe_below_20c - Advanced Furnace heats a cold pipe
# d0=Pipe Analyzer  d1=Pipe Digital Valve  d2=Advanced Furnace
# Pipe below 20C: valve ON, furnace On+Activate, SettingInput 5, SettingOutput 5.
#   While the furnace is above 100C, SettingInput drops to 0 (stop feeding).
# Pipe above 22C: valve OFF, furnace Off+Activate 0. Holds in between.
# db Setting: 0=idle 1=heating 2=heating, input paused (furnace hot) 9=fault

alias pipe d0
alias valve d1
alias furn d2
alias tc r0
alias fc r1
alias heat r2
alias cur r3
alias input r4
alias st r5

define HEAT_BELOW_C 20
define STOP_ABOVE_C 22
define FURNACE_MAX_C 100
define INPUT_COLD 5
define INPUT_HOT 0
define OUTPUT_SET 5

wait:
s db Setting 9
yield
bdns pipe wait
bdns valve wait
bdns furn wait
l heat valve On

main:
yield
bdns pipe wait
bdns valve wait
bdns furn wait
l cur pipe Error
bnez cur fault
l tc pipe Temperature
blez tc fault
sub tc tc 273.15
slt cur tc HEAT_BELOW_C
select heat cur 1 heat
sgt cur tc STOP_ABOVE_C
select heat cur 0 heat
l cur valve Lock
beqz cur v_unlocked
s valve Lock 0
v_unlocked:
l cur furn Lock
beqz cur f_unlocked
s furn Lock 0
f_unlocked:
beqz heat stop

l fc furn Temperature
sub fc fc 273.15
sgt cur fc FURNACE_MAX_C
select input cur INPUT_HOT INPUT_COLD
l cur furn SettingInput
beq cur input in_ok
s furn SettingInput input
in_ok:
l cur furn SettingOutput
beq cur OUTPUT_SET out_ok
s furn SettingOutput OUTPUT_SET
out_ok:
seq st input INPUT_HOT
add st st 1
move cur 1
jal set_all
s db Setting st
j main

fault:
move heat 0
s db Setting 9
move cur 0
jal set_all
j main

stop:
move cur 0
jal set_all
s db Setting 0
j main

# write valve On, furnace On and furnace Activate = cur (only on change)
set_all:
l input valve On
beq input cur sa_on
s valve On cur
sa_on:
l input furn On
beq input cur sa_act
s furn On cur
sa_act:
l input furn Activate
beq input cur sa_done
s furn Activate cur
sa_done:
j ra
