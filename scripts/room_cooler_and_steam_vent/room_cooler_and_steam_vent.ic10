# room_cooler_and_steam_vent - Wall Cooler when hot; vent runs while no steam
# d0=Gas Sensor (room)  d1=Wall Cooler  d2=Active Vent
# Cooler ON above 30C, OFF below 28C.
# Vent ON+Open while RatioSteam < 0.01%; OFF once steam > 0.1%.
# Set the vent's Mode/Setting in its own UI; this script only opens/runs it.
# db Setting: cooler + 2*vent (0..3), 9=device missing/no reading

alias sensor d0
alias cooler d1
alias vent d2
alias tc r0
alias steam r1
alias cool r2
alias run r3
alias cur r4
alias cur2 r5

define COOL_ON_ABOVE_C 30
define COOL_OFF_BELOW_C 28
define STEAM_NONE_BELOW 0.0001
define STEAM_SEEN_ABOVE 0.001

wait:
s db Setting 9
yield
bdns sensor wait
bdns cooler wait
bdns vent wait
l cool cooler On
l run vent On

main:
yield
bdns sensor wait
bdns cooler wait
bdns vent wait
l tc sensor Temperature
blez tc fault
sub tc tc 273.15
sgt cur tc COOL_ON_ABOVE_C
select cool cur 1 cool
slt cur tc COOL_OFF_BELOW_C
select cool cur 0 cool
l steam sensor RatioSteam
slt cur steam STEAM_NONE_BELOW
select run cur 1 run
sgt cur steam STEAM_SEEN_ABOVE
select run cur 0 run

apply:
l cur cooler On
beq cur cool vent_chk
s cooler On cool
vent_chk:
l cur vent On
l cur2 vent Open
bne cur run vent_write
beq cur2 run report
vent_write:
s vent Open run
s vent On run
report:
mul cur run 2
add cur cur cool
s db Setting cur
j main

fault:
move cool 0
move run 0
s db Setting 9
l cur cooler On
beqz cur fault_vent
s cooler On 0
fault_vent:
l cur vent On
beqz cur main
s vent On 0
s vent Open 0
j main
