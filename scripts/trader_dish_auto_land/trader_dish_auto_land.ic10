# trader_dish_auto_land - find trader, lock (SignalStrength=deg), interrogate, call down
# db=phase*100+ContactTypeId: 1 scan 2 lock 3 interrogate 4 done 5 landing; 900=no dish
alias dish d0
alias dial d1   # optional, trader type 0=any
alias lever d2  # optional, on = do not call down
alias led d3    # optional, SignalStrength
define SCAN_W 5000
define MAX_W 10000
reset:
jal show
bdns dish reset
s dish BestContactFilter -1
s dish Setting SCAN_W
move r10 1
scan:
add r0 r0 30
blt r0 360 scan_go
add r1 r1 20
mod r1 r1 100
scan_go:
jal probe
bltz r2 scan
l r5 dish SignalID
beq r5 r11 scan
bdns dial lock
l r6 dial Setting
beqz r6 lock
l r7 dish ContactTypeId
bne r7 r6 scan
lock:
s dish BestContactFilter r5
move r10 2
move r3 r2
div r4 r2 2
climb:
ble r3 2 locked
blt r4 0.5 locked
move r8 r0
move r9 r1
move r6 0
try:
move r0 r8
move r1 r9
mod r12 r6 2
select r12 r12 -1 1
mul r7 r4 r12
bge r6 2 try_v
mul r12 r1 0.0174533
sin r12 r12
max r12 r12 0.2
div r7 r7 r12
add r0 r0 r7
j try_go
try_v:
add r1 r1 r7
try_go:
jal probe
bltz r2 next
bge r2 r3 next
move r3 r2
j climb
next:
add r6 r6 1
blt r6 4 try
move r0 r8
move r1 r9
div r4 r4 2
j climb
locked:
move r10 3
s dish Setting MAX_W
l r7 dish Activate
bnez r7 interrogate
s dish Activate 1
move r13 600   # give up after 600 s
interrogate:
jal show
sleep 1
sub r13 r13 1
blez r13 finish
l r7 dish InterrogationProgress
bge r7 1 done
l r2 dish SignalStrength
bltz r2 reset
bgt r2 6 lock
j interrogate
done:
move r10 4
brdns lever 3   # no lever = call down
l r7 lever Open
bnez r7 finish
s dish Activate 1
move r10 5
finish:
move r11 r5
jal show
sleep 5
j reset
probe:
bgez r1 v_ok
mul r1 r1 -1
add r0 r0 180
v_ok:
mod r0 r0 360
min r1 r1 90
s dish Horizontal r0
s dish Vertical r1
wait_idle:
yield
bdns dish wait_idle
l r7 dish Idle
beqz r7 wait_idle
sleep 1
l r2 dish SignalStrength
show:
yield
move r7 900
bdns dish show_db
mul r7 r10 100
l r12 dish ContactTypeId
max r12 r12 0
add r7 r7 r12
show_db:
s db Setting r7
bdns led shown
s led Setting r2
shown:
j ra
