# trader_dish_auto_land - find trader, lock (SignalStrength=deg), interrogate, call down
# db=phase*100: 1 scan 2 lock 3xx interrogate (xx = %) 4 done 5 landing; 900=no dish
alias dish d0
alias skip d1   # optional button: skip this trader
alias lever d2  # optional, on = do not call down
alias led d3    # optional, SignalStrength
define SCAN_W 5000
define MAX_W 10000
reset:
move r10 1
jal show
bdns dish reset
s dish Activate 0  # stops any interrogation
s dish BestContactFilter -1
s dish Setting SCAN_W
scan:
add r0 r0 30   # 30 x 20 steps: all 60 positions in 60 moves
add r1 r1 20
mod r1 r1 100
jal probe
bltz r2 scan
l r5 dish SignalID
beq r5 r11 scan
lock:
s dish BestContactFilter r5
s dish Setting MAX_W
move r10 2
move r3 r2
div r4 r2 2
climb:
move r8 r0
move r9 r1
check:
l r7 dish WattsReachingContact
l r12 dish MinimumWattsToContact
max r12 r12 1
bge r7 r12 interrogate  # enough power on target
ble r3 2 interrogate
blt r4 0.5 interrogate
move r6 0
try:
move r0 r8
move r1 r9
mod r12 r6 2
select r12 r12 -1 1
mul r7 r4 r12
bge r6 2 try_v
mul r12 r1 0.0174533
sin r12 r12
max r12 r12 0.2
div r7 r7 r12
add r0 r0 r7
j try_go
try_v:
add r1 r1 r7
try_go:
jal probe
bltz r2 next
bge r2 r3 next
move r3 r2
j climb
next:
add r6 r6 1
blt r6 4 try
div r4 r4 2
j check
interrogate:
s dish Activate 1  # held at 1 while interrogating
jal show
l r7 dish InterrogationProgress
add r10 r7 3   # status 3xx = progress %
bge r7 1 done
l r12 dish SignalID
bltz r12 reset  # trader gone (SignalStrength -1 = resolving)
l r2 dish SignalStrength
bgt r2 6 lock
j interrogate
done:
move r10 4
brdns lever 3   # no lever = call down
l r7 lever Open
bnez r7 finish
s dish Activate 0  # call down = a fresh 0-1-0 press
yield
s dish Activate 1
yield
s dish Activate 0
move r10 5
finish:
move r11 r5
jal show
sleep 5
j reset
probe:
max r1 r1 0
mod r0 r0 360
min r1 r1 90
s dish Horizontal r0
s dish Vertical r1
move r14 18    # wait up to 9 s for the signal to resolve
wait_idle:
yield
brdns skip 3
l r12 skip Activate
bnez r12 finish
bdns dish wait_idle
l r7 dish Idle
beqz r7 wait_idle
l r2 dish SignalStrength
bgez r2 show
l r12 dish SignalID
bltz r12 show    # nothing in view
sub r14 r14 1
bgtz r14 wait_idle  # contact seen, still resolving
show:
yield
brdns skip 3
l r12 skip Activate
bnez r12 finish  # skip: remember it, scan on
move r7 900
bdns dish show_db
mul r7 r10 100
show_db:
s db Setting r7
brdns led 2
s led Setting r2
j ra
