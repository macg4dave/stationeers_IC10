# liquid_valves_open_when_cold - open ALL Liquid Digital Valves when liquid is cold
# d0=Liquid Pipe Analyzer. Every Liquid Digital Valve on the data network is driven.
# OPEN below 20C, CLOSE above 30C, holds in between (starts closed).
# Re-sends the state every ~10 s so newly built valves join in.
# db Setting: 0=closed 1=open 9=analyzer missing/no reading

alias liquid d0
alias tc r0
alias want r1
alias sent r2
alias ticks r3
alias cur r4

define OPEN_BELOW_C 20
define CLOSE_ABOVE_C 30
# Liquid Digital Valve prefab hash, from the working original script
define VALVE_HASH -517628750
define RESEND_TICKS 20

move sent -1

wait:
s db Setting 9
yield
bdns liquid wait

main:
yield
bdns liquid wait
l tc liquid Temperature
blez tc wait
sub tc tc 273.15
slt cur tc OPEN_BELOW_C
select want cur 1 want
sgt cur tc CLOSE_ABOVE_C
select want cur 0 want
sub ticks ticks 1
bne want sent send
bgtz ticks report
send:
sb VALVE_HASH On want
move sent want
move ticks RESEND_TICKS
report:
s db Setting want
j main
