# Close a Pipe Digital Valve when NO Methane is present
# d0 = Pipe Analyzer
# d1 = Pipe Digital Valve

alias pa d0
alias valve d1

alias vol r0
alias vol_hi r1

alias current_on r2
alias cond r3

# Treat values <= EPS as "not present" (covers tiny floating noise)
define EPS 0.000001

wait:
yield
bdns d0 wait
bdns d1 wait

loop:
yield

l vol pa RatioMethane

# vol_hi = 1 if vol > EPS, else 0
sgt vol_hi vol EPS

# Close valve when methane is not present
# (On = 1 only when methane is present)
l current_on valve On
sne cond vol_hi current_on
beqz cond skip_write
s valve On vol_hi
skip_write:
j loop
