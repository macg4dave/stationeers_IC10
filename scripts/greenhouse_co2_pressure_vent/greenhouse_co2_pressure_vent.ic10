# greenhouse_co2_pressure_vent - top up a room when CO2 or pressure is low
# d0=Gas Sensor (room)  d1=Active Vent (fed from a CO2-rich pipe)
# Vent ON+Open while CO2 < 20% OR room < 100 kPa.
# Vent OFF once CO2 > 22% AND room >= 100 kPa.
# Vent is kept in VENT_MODE with Setting = 100 kPa (its pressure limit).
# db Setting: 0=vent off 1=vent on 9=device missing

alias sensor d0
alias vent d1
alias co2 r0
alias kpa r1
alias want r2
alias cur r3
alias cur2 r4

define CO2_LOW 0.20
define CO2_OK 0.22
define ROOM_KPA 100
# 0 = Outward (pipe -> room), 1 = Inward (room -> pipe)
define VENT_MODE 0

wait:
s db Setting 9
yield
bdns sensor wait
bdns vent wait
l want vent On

main:
yield
bdns sensor wait
bdns vent wait
l co2 sensor RatioCarbonDioxide
l kpa sensor Pressure
slt cur co2 CO2_LOW
slt cur2 kpa ROOM_KPA
or cur cur cur2
select want cur 1 want
sgt cur co2 CO2_OK
sge cur2 kpa ROOM_KPA
and cur cur cur2
select want cur 0 want
s db Setting want
l cur vent Mode
beq cur VENT_MODE mode_ok
s vent Lock 0
s vent Mode VENT_MODE
yield
mode_ok:
l cur vent Setting
beq cur ROOM_KPA set_ok
s vent Lock 0
s vent Setting ROOM_KPA
set_ok:
l cur vent On
l cur2 vent Open
bne cur want write
beq cur2 want main
write:
s vent Lock 0
s vent Open want
s vent On want
j main
