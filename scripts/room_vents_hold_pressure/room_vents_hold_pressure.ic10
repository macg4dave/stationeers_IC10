# room_vents_hold_pressure - Active Vents keep a room between 90 and 120 kPa
# d0=Gas Sensor (room). Active Vents named exactly ROOM_VENT on the network.
# Below 90 kPa: vents blow in (Outward, stop at 120 kPa) until 120 kPa.
# Above 120 kPa: vents pull out (Inward, stop at 90 kPa) until 90 kPa.
# Between: vents OFF. Vents are set once, when the state changes.
# db Setting: 0=idle 1=filling 2=exhausting 9=sensor missing

alias sensor d0
alias kpa r0
alias state r1
alias mode r2
alias set r3

define LOW_KPA 90
define HIGH_KPA 120
define VENT_HASH -1129453144
define VENT_NAME HASH("ROOM_VENT")
define MODE_OUTWARD 0
define MODE_INWARD 1

wait:
s db Setting 9
yield
bdns sensor wait
j stop

main:
yield
bdns sensor wait
l kpa sensor Pressure
beq state 1 filling
beq state 2 exhausting
blt kpa LOW_KPA fill
bgt kpa HIGH_KPA exhaust
s db Setting 0
sleep 1
j main

filling:
bge kpa HIGH_KPA stop
j main
exhausting:
ble kpa LOW_KPA stop
j main

fill:
move state 1
move mode MODE_OUTWARD
move set HIGH_KPA
j run
exhaust:
move state 2
move mode MODE_INWARD
move set LOW_KPA
run:
s db Setting state
sbn VENT_HASH VENT_NAME Lock 0
sbn VENT_HASH VENT_NAME Mode mode
yield
sbn VENT_HASH VENT_NAME Setting set
sbn VENT_HASH VENT_NAME Open 1
sbn VENT_HASH VENT_NAME On 1
sbn VENT_HASH VENT_NAME Lock 1
j main

stop:
move state 0
s db Setting 0
sbn VENT_HASH VENT_NAME Lock 0
sbn VENT_HASH VENT_NAME On 0
sbn VENT_HASH VENT_NAME Open 0
sleep 1
j main
