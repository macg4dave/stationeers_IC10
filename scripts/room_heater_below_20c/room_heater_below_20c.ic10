# room_heater_below_20c
# Category: Controller
# Status: Functional
#
# Purpose:
# - If Gas Sensor temperature < 20C: turn ON a Wall Heater.
# - Otherwise turn the Wall Heater OFF.
#
# Device registers:
#   d0 = Gas Sensor
#   d1 = Wall Heater
#
# Notes:
# - Gas Sensor Temperature is Kelvin (K). Convert to Celsius via C = K - 273.15.

alias gas_read d0
alias heater d1

alias tempC r0
alias cond r1
alias desired_heater_on r2
alias current_heater_on r3
alias sensor_hash r4

define KELVIN_TO_C 273.15
define HEAT_ON_BELOW_C 20

# Gas Sensor prefab hash from catalog/devices/Gas_Sensor.json
define GAS_SENSOR_HASH -1252983604

wait_devices:
yield
bdns d0 wait_devices
bdns d1 wait_devices

main:
bdns d0 wait_devices
bdns d1 wait_devices
l sensor_hash gas_read PrefabHash
bne sensor_hash GAS_SENSOR_HASH wait_devices

l tempC gas_read Temperature
sub tempC tempC KELVIN_TO_C

# Heater ON when tempC < HEAT_ON_BELOW_C
slt cond tempC HEAT_ON_BELOW_C
select desired_heater_on cond 1 0

# avoid redundant writes (and network spam): only set when it changes
l current_heater_on heater On
sne cond desired_heater_on current_heater_on
beqz cond done
s heater On desired_heater_on
done:

yield
j main
