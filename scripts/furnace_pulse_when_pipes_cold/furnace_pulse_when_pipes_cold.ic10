# furnace_pulse_when_pipes_cold - pulse an Advanced Furnace when pipes are cold
# d0=Liquid Pipe Analyzer  d1=Pipe Analyzer (gas)  d2=Pipe Digital Valve
# d3=Advanced Furnace
# Every CYCLE_S: if gas < 30C OR liquid < 80C, valve ON and furnace Activate=1
# for PULSE_TICKS, then both OFF. Otherwise valve OFF, Activate 0.
# CHECK: 0=both analyzers, 1=gas only (d0 unused), 2=liquid only (d1 unused)
# db Setting: 0=warm, idle 1=cold, pulsed 9=device missing

alias liquid d0
alias gas d1
alias valve d2
alias furn d3
alias tc r0
alias cold r1
alias cur r2
alias n r3

define CHECK 0
define GAS_COLD_C 30
define LIQUID_COLD_C 80
define PULSE_TICKS 2
define CYCLE_S 30

main:
s db Setting 9
yield
bdns valve main
bdns furn main
move cold 0
beq CHECK 2 liquid_chk
bdns gas main
l tc gas Temperature
sub tc tc 273.15
slt cur tc GAS_COLD_C
or cold cold cur
liquid_chk:
beq CHECK 1 decide
bdns liquid main
l tc liquid Temperature
sub tc tc 273.15
slt cur tc LIQUID_COLD_C
or cold cold cur
decide:
s db Setting cold
beqz cold all_off
l cur valve On
bnez cur v_on
s valve On 1
v_on:
s furn Activate 1
move n PULSE_TICKS
pulse:
yield
sub n n 1
bgtz n pulse
all_off:
l cur furn Activate
beqz cur f_off
s furn Activate 0
f_off:
l cur valve On
beqz cur rest
s valve On 0
rest:
sleep CYCLE_S
j main
