# liquid_pipe_purge_lever - lever empties a liquid pipe, LED shows the state
# d0=Lever  d1=Liquid Pipe Analyzer  d2=Liquid Digital Valve  d3=Active Vent
# d4=Active Liquid Outlet  d5=LED
# Lever ON and pipe pressure > 0.001 kPa => valve, vent and outlet ON.
# Anything else (lever off, pipe empty, analyzer Error) => all OFF.
# LED: yellow=contents, lever off  red=purging  green=empty, lever on  off=idle
# db Setting: 0=idle 1=purging 2=has contents, lever off 3=empty, lever on

alias lever d0
alias pipe d1
alias valve d2
alias vent d3
alias outlet d4
alias led d5
alias lev r0
alias full r1
alias want r2
alias cur r3
alias cur2 r4
alias color r5
alias st r6

define MIN_KPA 0.001
define GREEN 2
define RED 4
define YELLOW 5

wait:
yield
bdns lever wait
bdns pipe wait
bdns valve wait
bdns vent wait
bdns outlet wait
bdns led wait

main:
yield
bdns lever wait
bdns pipe wait
bdns valve wait
bdns vent wait
bdns outlet wait
bdns led wait
l lev lever Open
move full 0
l cur pipe Error
bnez cur decide
l cur pipe Pressure
sgt full cur MIN_KPA
decide:
and want lev full
# st: 0 idle, 1 purging, 2 contents+lever off, 3 empty+lever on
mul st lev 3
mul cur full 2
add st st cur
select st want 1 st
seq cur st 3
select color cur GREEN YELLOW
select color want RED color
s db Setting st

l cur valve On
beq cur want valve_ok
s valve On want
valve_ok:
l cur vent On
l cur2 vent Open
bne cur want vent_w
beq cur2 want vent_ok
vent_w:
s vent Open want
s vent On want
vent_ok:
l cur outlet On
beq cur want outlet_ok
s outlet On want
outlet_ok:
snez cur2 st
l cur led On
beq cur cur2 led_on_ok
s led On cur2
led_on_ok:
beqz cur2 main
l cur led Color
beq cur color main
s led Color color
j main
