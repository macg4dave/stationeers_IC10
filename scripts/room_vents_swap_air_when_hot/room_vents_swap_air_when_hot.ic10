# room_vents_swap_air_when_hot - swap room air while the room is hot
# d0=Gas Sensor (room). Active Vents named exactly IN and OUT on the network.
# Above 30C: IN vents blow pipe gas into the room (Outward, up to 60 MPa),
#            OUT vents pull room air into their pipe (Inward, down to 0 kPa).
# Below 28C: both groups OFF and closed. Holds in between.
# Starts by forcing a known state; re-applies ON every ~60 s.
# db Setting: 0=off 1=swapping 9=sensor missing/no reading

alias sensor d0
alias tc r0
alias want r1
alias state r2
alias ticks r3
alias cur r4

define VENT_HASH -1129453144
define IN_NAME HASH("IN")
define OUT_NAME HASH("OUT")
define MODE_OUTWARD 0
define MODE_INWARD 1
define IN_SETTING_KPA 60000
define OUT_SETTING_KPA 0
define ON_ABOVE_C 30
define OFF_BELOW_C 28
define LOOP_SLEEP_S 2
define REAPPLY_LOOPS 30

move state -1
move want 0

wait:
s db Setting 9
yield
bdns sensor wait

main:
bdns sensor wait
l tc sensor Temperature
blez tc wait
sub tc tc 273.15
sgt cur tc ON_ABOVE_C
select want cur 1 want
slt cur tc OFF_BELOW_C
select want cur 0 want
s db Setting want
bne want state apply
beqz state rest
sub ticks ticks 1
bgtz ticks rest
apply:
move state want
move ticks REAPPLY_LOOPS
sbn VENT_HASH IN_NAME Lock 0
sbn VENT_HASH OUT_NAME Lock 0
beqz want all_off
sbn VENT_HASH IN_NAME Mode MODE_OUTWARD
sbn VENT_HASH OUT_NAME Mode MODE_INWARD
yield
sbn VENT_HASH IN_NAME Setting IN_SETTING_KPA
sbn VENT_HASH OUT_NAME Setting OUT_SETTING_KPA
move cur 1
j write
all_off:
move cur 0
write:
sbn VENT_HASH IN_NAME Open cur
sbn VENT_HASH IN_NAME On cur
sbn VENT_HASH IN_NAME Lock cur
sbn VENT_HASH OUT_NAME Open cur
sbn VENT_HASH OUT_NAME On cur
sbn VENT_HASH OUT_NAME Lock cur
rest:
sleep LOOP_SLEEP_S
j main
