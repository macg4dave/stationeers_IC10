# pipe_heater_hold_20c - Pipe Heater keeps a pipe near 20C
# d0=Pipe Analyzer  d1=Pipe Heater
# Heater ON below 20C, OFF above 22C, holds in between.
# Analyzer Error, empty pipe or missing device => heater OFF.
# db Setting: 0=heater off 1=heater on 9=fault/device missing

alias pipe d0
alias heater d1
alias tc r0
alias want r1
alias cur r2

define HEAT_ON_BELOW_C 20
define HEAT_OFF_ABOVE_C 22

wait:
s db Setting 9
yield
bdns pipe wait
bdns heater wait
l want heater On

main:
yield
bdns pipe wait
bdns heater wait
l cur pipe Error
bnez cur fault
l tc pipe Temperature
blez tc fault
sub tc tc 273.15
slt cur tc HEAT_ON_BELOW_C
select want cur 1 want
sgt cur tc HEAT_OFF_ABOVE_C
select want cur 0 want
l cur heater On
beq cur want report
s heater On want
report:
s db Setting want
j main

fault:
move want 0
l cur heater On
beqz cur fault_done
s heater On 0
fault_done:
s db Setting 9
j main
