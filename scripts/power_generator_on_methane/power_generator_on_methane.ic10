# power_generator_on_methane - Gas Fuel Generator runs while its fuel has methane
# d0=Pipe Analyzer (generator fuel pipe)  d1=Gas Fuel Generator
# Generator ON while RatioMethane > 0 (above float noise), OFF when none.
# Analyzer switched off => script turns it on. Analyzer Error => generator OFF.
# db Setting: 0=gen off 1=gen on 3=analyzer error 4=analyzer was off 9=missing

alias pipe d0
alias gen d1
alias ch4 r0
alias want r1
alias cur r2
alias st r3

define EPS 0.000001

wait:
s db Setting 9
yield
bdns pipe wait
bdns gen wait

main:
yield
bdns pipe wait
bdns gen wait
move want 0
move st 4
l cur pipe On
beqz cur analyzer_off
move st 3
l cur pipe Error
bnez cur apply
l ch4 pipe RatioMethane
sgt want ch4 EPS
move st want
j apply
analyzer_off:
s pipe On 1
apply:
s db Setting st
l cur gen On
beq cur want main
s gen On want
j main
