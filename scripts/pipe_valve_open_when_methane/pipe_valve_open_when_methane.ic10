# pipe_valve_open_when_methane - valve open only while the pipe has methane
# d0=Pipe Analyzer  d1=Pipe Digital Valve
# Valve ON while RatioMethane > 0 (above float noise), OFF when there is none.
# Analyzer Error => valve OFF.
# db Setting: 0=closed 1=open 9=fault/device missing

alias pipe d0
alias valve d1
alias ch4 r0
alias want r1
alias cur r2

define EPS 0.000001

wait:
s db Setting 9
yield
bdns pipe wait
bdns valve wait

main:
yield
bdns pipe wait
bdns valve wait
move want 0
l cur pipe Error
bnez cur apply
l ch4 pipe RatioMethane
sgt want ch4 EPS
apply:
select cur cur 9 want
s db Setting cur
l cur valve On
beq cur want main
s valve On want
j main
