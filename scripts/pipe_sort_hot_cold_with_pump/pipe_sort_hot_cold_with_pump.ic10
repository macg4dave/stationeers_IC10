# pipe_sort_hot_cold_with_pump - route gas by temperature, pump holds pressure
# d0=Pipe Analyzer  d1=Pipe Digital Valve (hot)  d2=Pipe Digital Valve (cold)
# d3=Pipe Volume Pump
# Cold valve: open below 20C, close above 24C. Hot valve: open above 40C,
# close below 36C. Never both open. Pump ON below 9.75 MPa, OFF above 10.25 MPa.
# Analyzer Error => pump OFF (valves hold).
# db Setting: cold + 2*hot + 4*pump, 9=fault/device missing

alias pipe d0
alias hot d1
alias cold d2
alias pump d3
alias tc r0
alias kpa r1
alias wc r2
alias wh r3
alias wp r4
alias cur r5

define COLD_OPEN_BELOW_C 20
define COLD_CLOSE_ABOVE_C 24
define HOT_OPEN_ABOVE_C 40
define HOT_CLOSE_BELOW_C 36
define TARGET_KPA 10000
define BAND_KPA 250
define PUMP_SETTING_L 1

wait:
s db Setting 9
yield
bdns pipe wait
bdns hot wait
bdns cold wait
bdns pump wait

main:
yield
bdns pipe wait
bdns hot wait
bdns cold wait
bdns pump wait
l cur pipe Error
bnez cur fault
l tc pipe Temperature
sub tc tc 273.15
l kpa pipe Pressure
l wc cold On
l wh hot On
slt cur tc COLD_OPEN_BELOW_C
select wc cur 1 wc
sgt cur tc COLD_CLOSE_ABOVE_C
select wc cur 0 wc
sgt cur tc HOT_OPEN_ABOVE_C
select wh cur 1 wh
slt cur tc HOT_CLOSE_BELOW_C
select wh cur 0 wh
select wh wc 0 wh
select wc wh 0 wc
l cur cold On
beq cur wc cold_ok
s cold On wc
cold_ok:
l cur hot On
beq cur wh hot_ok
s hot On wh
hot_ok:
l wp pump On
sub cur TARGET_KPA BAND_KPA
slt cur kpa cur
select wp cur 1 wp
add cur TARGET_KPA BAND_KPA
sgt cur kpa cur
select wp cur 0 wp
l cur pump Setting
beq cur PUMP_SETTING_L pump_set
s pump Setting PUMP_SETTING_L
pump_set:
jal set_pump
mul cur wh 2
add cur cur wc
mul wp wp 4
add cur cur wp
s db Setting cur
j main

fault:
move wp 0
jal set_pump
s db Setting 9
j main

set_pump:
l cur pump On
beq cur wp sp_done
s pump On wp
sp_done:
j ra
