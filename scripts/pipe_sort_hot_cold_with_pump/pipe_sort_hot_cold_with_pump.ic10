# pipe_sort_hot_cold_with_pump - route gas by temperature, pump holds pressure
# d0=Pipe Analyzer d1=Digital Valve (hot) d2=Digital Valve (cold) d3=Volume Pump (opt.)
# Cold valve open <20C, shut >24C. Hot valve open >40C, shut <36C. Never both open.
# Every Pipe Heater on the network is ON while the cold valve is open.
# Pump ON <9.75 MPa, OFF >10.25 MPa. Analyzer Error => pump+heaters OFF, valves hold.
# db Setting: cold + 2*hot + 4*pump, 9=fault/device missing

alias analyzer d0
alias hot d1
alias cold d2
alias pump d3
alias tc r0
alias kpa r1
alias wc r2
alias wh r3
alias wp r4
alias cur r5

define COLD_OPEN_BELOW_C 20
define COLD_CLOSE_ABOVE_C 24
define HOT_OPEN_ABOVE_C 40
define HOT_CLOSE_BELOW_C 36
define TARGET_KPA 10000
define BAND_KPA 250
define PUMP_SETTING_L 1
define HEATER -419758574

wait:
s db Setting 9
yield
bdns analyzer wait
bdns hot wait
bdns cold wait

main:
yield
bdns analyzer wait
bdns hot wait
bdns cold wait
l cur analyzer Error
bnez cur fault
l tc analyzer Temperature
sub tc tc 273.15
l kpa analyzer Pressure
l wc cold On
l wh hot On
slt cur tc COLD_OPEN_BELOW_C
select wc cur 1 wc
sgt cur tc COLD_CLOSE_ABOVE_C
select wc cur 0 wc
sgt cur tc HOT_OPEN_ABOVE_C
select wh cur 1 wh
slt cur tc HOT_CLOSE_BELOW_C
select wh cur 0 wh
select wh wc 0 wh
select wc wh 0 wc
l cur cold On
beq cur wc cold_ok
s cold On wc
cold_ok:
l cur hot On
beq cur wh hot_ok
s hot On wh
hot_ok:
lb cur HEATER On Average
beq cur wc heat_ok
sb HEATER On wc
heat_ok:
move wp 0
bdns pump report
l wp pump On
sub cur TARGET_KPA BAND_KPA
slt cur kpa cur
select wp cur 1 wp
add cur TARGET_KPA BAND_KPA
sgt cur kpa cur
select wp cur 0 wp
l cur pump Setting
beq cur PUMP_SETTING_L pump_set
s pump Setting PUMP_SETTING_L
pump_set:
jal set_pump
report:
mul cur wh 2
add cur cur wc
mul wp wp 4
add cur cur wp
s db Setting cur
j main

fault:
s db Setting 9
lb cur HEATER On Maximum
blez cur heat_off
sb HEATER On 0
heat_off:
bdns pump main
move wp 0
jal set_pump
j main

set_pump:
l cur pump On
beq cur wp sp_done
s pump On wp
sp_done:
j ra
