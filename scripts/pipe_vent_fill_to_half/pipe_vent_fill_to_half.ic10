# pipe_vent_fill_to_half - Active Vent fills a pipe to half a target pressure
# d0=Pipe Analyzer  d1=Active Vent (set its Mode/Setting in its own UI)
# Vent ON+Open below 50% of TARGET_KPA, OFF above 55%, holds in between.
# Analyzer Error => vent OFF.
# db Setting: 0=vent off 1=vent on 9=fault/device missing

alias pipe d0
alias vent d1
alias kpa r0
alias want r1
alias cur r2
alias cur2 r3

define TARGET_KPA 100
define ON_BELOW 0.50
define OFF_ABOVE 0.55

wait:
s db Setting 9
yield
bdns pipe wait
bdns vent wait
l want vent On

main:
yield
bdns pipe wait
bdns vent wait
l cur pipe Error
bnez cur fault
l kpa pipe Pressure
div kpa kpa TARGET_KPA
slt cur kpa ON_BELOW
select want cur 1 want
sgt cur kpa OFF_ABOVE
select want cur 0 want
s db Setting want
j apply
fault:
move want 0
s db Setting 9
apply:
l cur vent On
l cur2 vent Open
bne cur want write
beq cur2 want main
write:
s vent Open want
s vent On want
j main
